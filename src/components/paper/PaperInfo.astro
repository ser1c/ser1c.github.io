---
import PaperLink from "./PaperLink.astro"

/*
  titleTag: on a paper's own page the title is the document's h1 and is set at
  --size-2. In the index list it stays an h2 at body size. Previously it was
  always an h2 at --size-0, which left the title smaller than the word
  "Abstract" further down its own page.
*/
const {
	data,
	slug = "",
	includeSummary = false,
	noAnimation = false,
	titleTag = "h2",
	// The paper's own page renders its links as buttons instead, and a
	// "Details" link pointing at the page you are already on is noise.
	showLinks = true,
	// Suppressed under the homepage's "Job Market Paper" heading, which would
	// otherwise say it twice within a couple of lines.
	showJmpLabel = true,
} = Astro.props

const TitleTag = titleTag
const isPageTitle = titleTag === "h1"

function combineNames(names) {
	if (names.length === 0) return ""
	if (names.length === 1) return `with ${names[0]}`
	if (names.length === 2) return `with ${names[0]} and ${names[1]}`
	return `with ${names.slice(0, -1).join(", ")}, and ${names.slice(-1)}`
}

const author_names = data.author
	? combineNames(data.author.map((author) => author.name))
	: ""
---

<div class={`paper-info ${!noAnimation ? 'opacity-0 translate-y-4' : ''} transition-all duration-500 hover:bg-mountain-50/50 p-4 rounded-lg -mx-4`} data-paper-item>
	{isPageTitle ? (
		<h1 class="font-bold text-size-2 !text-black dark:!text-white leading-tight" set:html={data.title} />
	) : (
		/*
		  The dhaka-yellow rule sits on the heading, not on the link inside it.
		  On the link it was a side effect of `inline-block`: it hugged the text
		  on a one-line title but ran the full container width once the title
		  wrapped. On the heading it is the same full-width rule every time.
		*/
		<TitleTag class="cursor-pointer font-bold text-size-0 group border-b border-dhaka-yellow pb-size-3xs">
			<a
				href={`/papers/${slug}`}
				set:html={data.title}
				class="no-underline hover:text-dhaka-red transition-colors"
			/>
		</TitleTag>
	)}

	{author_names != "" && <p class="mt-size-2xs text-size--1 text-mountain-600">{author_names}</p>}

	<p class="mt-size-2xs text-mountain-500 dark:!text-mountain-300 italic text-size--1">
		{data.jobMarketPaper && showJmpLabel && (
			<Fragment><strong class="not-italic text-mountain-700 dark:!text-mountain-100">Job Market Paper</strong> &middot; </Fragment>
		)}
		<Fragment set:html={data.status} />
	</p>

	{/* Summary sits above the links: it is what decides whether someone clicks. */}
	{includeSummary && (
		<p class="mt-size-xs text-size-0 text-mountain-700 dark:!text-mountain-100 leading-relaxed" set:html={data.summary} />
	)}

	{/* The Details link is rendered even when a paper has no downloadable
	    links, so an embargoed paper is still reachable from the index. */}
	{showLinks && (
		<p class="mt-size-xs text-size--1 flex flex-wrap gap-2">
			<PaperLink
				name="Details"
				url={`/papers/${slug}`}
				includeRightBar={data.links && data.links.length > 0}
			/>
			{data.links && data.links.map((link: { name: string; url: string }, i: number) => (
				<PaperLink
					name={link.name}
					url={link.url}
					includeRightBar={i < data.links.length - 1}
				/>
			))}
		</p>
	)}
</div>

<style>
  .paper-info {
    position: relative;
    overflow: hidden;
  }

  .paper-info::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--color-dhaka-red);
    transition: height 0.3s ease;
  }

  .paper-info:hover::before {
    height: 100%;
  }
</style>